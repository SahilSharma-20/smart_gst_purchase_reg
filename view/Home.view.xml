<mvc:View controllerName="gstpr.zfigstpregister.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page id="page" showNavButton="false" class="sapUiNoContentPadding gstPage">

        <customHeader>
            <Bar class="gstPageHeader">
                <contentLeft>
                    <core:Icon src="sap-icon://document-text" size="1.2rem" color="#0064d9" class="sapUiSmallMarginEnd"/>
                    <Title text="GST Purchase Register" titleStyle="H5" class="gstPageTitle"/>
                </contentLeft>
                <contentRight>
                    <Button id="btnAnalyse"
                        text="Analyse"
                        icon="sap-icon://ai"
                        type="Emphasized"
                        press="onAnalyse"
                        class="analyseBtn sapUiSmallMarginEnd"/>
                    <Button id="btnColumnSettings"
                        icon="sap-icon://action-settings"
                        tooltip="Show / Hide Columns"
                        type="Transparent"
                        press="onColumnSettings"/>
                </contentRight>
            </Bar>
        </customHeader>

        <content>

            <!-- AI Executive Summary Panel -->
            <Panel id="aiSummaryPanel" visible="false" class="aiSummaryPanel">
                <headerToolbar>
                    <Toolbar height="2.5rem">
                        <core:Icon src="sap-icon://ai" size="1rem" color="#0064d9" class="sapUiTinyMarginEnd"/>
                        <Title text="AI Executive Summary" titleStyle="H6"/>
                        <ToolbarSpacer/>
                        <Button icon="sap-icon://decline" type="Transparent" tooltip="Close" press="onCloseAnalysis"/>
                    </Toolbar>
                </headerToolbar>
                <VBox id="aiSummaryContent" class="aiSummaryContent"/>
            </Panel>

            <!-- Active Drill-Down Badge (hidden by default) -->
            <HBox id="drillDownBadgeBar" visible="false" alignItems="Center" class="drillDownBadgeBar">
                <core:Icon src="sap-icon://filter" size="0.85rem" color="#0064d9" class="sapUiTinyMarginEnd"/>
                <Text id="drillDownBadgeText" text="" class="drillDownBadgeText"/>
                <Button id="drillDownClearBtn"
                    text="Clear Filter"
                    icon="sap-icon://sys-cancel"
                    type="Transparent"
                    press="onClearDrillDown"
                    class="drillDownClearBtn"/>
            </HBox>

            <!-- Filter Bar -->
            <Panel class="gstFilterPanel">
                <HBox wrap="Wrap" alignItems="End" class="gstFilterRow">
                    <VBox class="gstFilterItem">
                        <Label text="Company Code" design="Bold"/>
                        <ComboBox id="filterCompanyCode" width="150px" placeholder="All"/>
                    </VBox>
                    <VBox class="gstFilterItem">
                        <Label text="Posting Date From" design="Bold"/>
                        <DatePicker id="filterDateFrom" width="160px"
                            placeholder="DD.MM.YYYY"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="dd.MM.yyyy"/>
                    </VBox>
                    <VBox class="gstFilterItem">
                        <Label text="Posting Date To" design="Bold"/>
                        <DatePicker id="filterDateTo" width="160px"
                            placeholder="DD.MM.YYYY"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="dd.MM.yyyy"/>
                    </VBox>
                    <VBox class="gstFilterItem">
                        <Label text="Document Number" design="Bold"/>
                        <Input id="filterDocNo" width="155px" placeholder="Doc No."/>
                    </VBox>
                    <VBox class="gstFilterItem">
                        <Label text="Business Area" design="Bold"/>
                        <ComboBox id="filterBusinessArea" width="145px" placeholder="All"/>
                    </VBox>
                    <VBox class="gstFilterItem">
                        <Label text="Business Place" design="Bold"/>
                        <ComboBox id="filterBusinessPlace" width="145px" placeholder="All"/>
                    </VBox>
                    <HBox alignItems="Center" class="gstFilterBtns">
                        <Button id="btnGo" text="Go" type="Emphasized"
                            icon="sap-icon://search" press="onGo"
                            class="sapUiTinyMarginEnd"/>
                        <Button id="btnReset" text="Reset"
                            icon="sap-icon://refresh" press="onReset"/>
                    </HBox>
                </HBox>
            </Panel>

            <!-- Record Info Bar -->
            <HBox alignItems="Center" justifyContent="SpaceBetween" class="gstInfoBar">
                <Text id="txtRecordCount" text="Loading..." class="gstRecordCount"/>
            </HBox>

            <!-- Main Table -->
            <t:Table
                id="gstTable"
                visibleRowCount="15"
                minAutoRowCount="12"
                selectionMode="None"
                alternateRowColors="true"
                columnHeaderHeight="42"
                rowHeight="36"
                enableColumnReordering="true"
                class="gstMainTable">
            </t:Table>

        </content>
    </Page>
</mvc:View>